# --- environment ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.claude/

# --- local safety-net snapshots (no git on the dev machine; see aad/docs/m1-data-pipeline.md) ---
backups/

# --- documents that must not be published from this (public) repo ---
# The reproduced paper is copyrighted (IEEE TCE 2025); it is cited by DOI in
# aad/README.md instead. The FYP proposal stays private.
A_Secure_Adversarial_Attack_Detector_Framework_for_Monitoring_Network_Intrusion_in_IoT_Environment.pdf
Proposal.pdf

# --- downloaded data (CICIoT2023 merged CSV, 13.75 GB; see aad/README.md "Setup") ---
aad/data/raw/*.csv

# --- generated by scripts/01_prepare.py ---
aad/data/interim/*
aad/data/processed/*
# throwaway output of the --sample-frac smoke test; never a real result
aad/data/smoke/*

# --- generated by scripts/02_train_baselines.py onward ---
aad/artifacts/models/*
# adversarial/ holds the test-split examples; 03_generate_ae.py --split train
# writes adversarial_train/ for phase 6 to adversarially train on
aad/artifacts/adversarial*/*
aad/artifacts/discriminator/*

# --- archived CSE-CIC-IDS2018 run (aad/archive/cicids2018/) ---
# The reports, README and configs there are text and ARE tracked: they are the
# reproduction results the thesis compares against. The trained weights are
# binary and stay out of version control, exactly as they did before archiving.
aad/archive/cicids2018/models/*
aad/archive/cicids2018/discriminator/*.joblib

# artifacts/reports/ is deliberately NOT ignored: the result tables are small,
# text, diffable, and are the point of the project.

# keep the empty directory structure so a fresh clone has somewhere to write
!**/.gitkeep
